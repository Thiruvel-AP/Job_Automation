\documentclass[a4paper,10pt]{article}
\#{ One-page layout copied from the user's own CV (agreed 2026-10-03). Only fact-bank values are inserted.
   Optional fields are read with .get, so a missing one is skipped, never an error. }
\usepackage{fontspec}
\setmainfont{Carlito}
\usepackage[margin=0.55in, top=0.45in, bottom=0.45in]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{xcolor}
\usepackage{microtype}

\definecolor{headernavy}{RGB}{12, 83, 166}
\definecolor{linkblue}{RGB}{0, 102, 204}
\hypersetup{colorlinks=true, linkcolor=linkblue, urlcolor=linkblue}

% headings 11pt on a 10.5pt body (the 10pt class would otherwise make them smaller than the text)
\titleformat{\section}{\color{headernavy}\fontsize{11}{13}\selectfont\bfseries}{}{0em}{\MakeUppercase}[\color{headernavy}\titlerule]
\titlespacing{\section}{0pt}{6pt}{3pt}
\setlist[itemize]{noitemsep, topsep=1pt, leftmargin=1.2em, partopsep=0pt, parsep=0.5pt}
\pagestyle{empty}
\setlength{\parindent}{0pt}
% no hyphenation: pdftotext turns 'scal-able' into two tokens and naive ATS matching misses them
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=3em

% entry heading: org (left) dates (right) / role (left) location (right)
\newcommand{\num}[1]{\textbf{#1}}   % the hook's number in the headline
% v3.5.3: org, location / title, dates: `pdftotext -raw` reads employer -> title -> dates -> bullets (args: org, dates, title, location)
\newcommand{\entry}[4]{\noindent\textbf{#1}\hfill\textit{#4}\\ \textit{#3}\hfill\textbf{#2}\par}

\begin{document}
\fontsize{10.5}{12.6}\selectfont

% ---------------- HEADER ----------------
\begin{center}
  {\LARGE\bfseries \VAR{id.name|e}}\\[3pt]
\BLOCK{set headline = hook_headline|default('') or id.headline|default('')}
\BLOCK{if hook_headline|default('') and headline_title|default('') and headline_title != hook_headline}\BLOCK{set headline = headline_title ~ ' | ' ~ hook_headline}\BLOCK{endif}
\BLOCK{if headline}
  {\color{headernavy}\small\textbf{\VAR{headline|hook_tex(hook_number|default(''), 'num')}}}\\[2pt]
\BLOCK{endif}
  {\small \VAR{id|contact_line}}\BLOCK{if id.get('status_line')}\\[1pt]
  \VAR{id.status_line|map('e')|join(' \\,\\textbar\\, ')}\BLOCK{endif}

\end{center}

% ---------------- PROFILE ----------------
\section{Profile}
\VAR{profile|e}

% ---------------- EXPERIENCE ----------------
\section{Experience}
\BLOCK{for e in experience}
\BLOCK{if not loop.first}
\vspace{3pt}
\BLOCK{endif}
\entry{\VAR{e.org|e}}{\VAR{e.dates|e}}{\VAR{e.title|e}}{\VAR{e.get('location', '')|e}}
\begin{itemize}
\BLOCK{for b in e.bullets}
  \item \VAR{b|e}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endfor}

% ---------------- PROJECTS ----------------
\section{Projects}
\BLOCK{for p in projects}
\noindent\textbf{\VAR{p.name|e}}\BLOCK{if p.get('stack')} -- \textit{\VAR{p.stack|e}}\BLOCK{endif} \hfill \BLOCK{if p|award}\textit{\VAR{(p|award)|e}}\BLOCK{elif p.get('github')}\url{\VAR{p.github}}\BLOCK{endif}

\begin{itemize}
\BLOCK{for b in p.bullets}
  \item \VAR{b|e}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endfor}

% ---------------- SKILLS ----------------
\section{Skills}
\BLOCK{for group, items in skills.items()}
\textbf{\VAR{group|e}:} \VAR{items|map('skill')|join(', ')}\BLOCK{if not loop.last}\\\BLOCK{endif}

\BLOCK{endfor}

% ---------------- EDUCATION ----------------
\section{Education}
\BLOCK{for ed in education}
\BLOCK{if not loop.first}
\vspace{2pt}
\BLOCK{endif}
\textbf{\VAR{ed.degree|e}}, \VAR{ed.org|e} \hfill \textbf{\VAR{ed.dates|e}}\BLOCK{if ed.get('details')}\\ \textit{\VAR{ed.details|e}}\BLOCK{endif}\BLOCK{if ed.get('grade') or ed.get('note')}\\ \textit{\VAR{(ed.get('grade') or ed.get('note'))|e}}\BLOCK{endif}\par
\BLOCK{endfor}
\BLOCK{if certifications}

% ---------------- CERTIFICATIONS ----------------
\section{Certifications \& Awards}
\VAR{certifications|map('cert_text')|map('e')|join(' \\,$|$\\, ')}
\BLOCK{endif}

\end{document}
