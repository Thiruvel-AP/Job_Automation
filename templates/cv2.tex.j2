\documentclass[a4paper,11pt]{article}
\#{ Two-page layout (the default), v2.3. The preamble is the user's current CV (templates/reference/cv_reference_2026-10-29.tex) line for line:
   Carlito 11pt, geometry margin 0.6in with top and bottom 0.5in, headernavy RGB(12,83,166) for the section titles (11pt bold, uppercase, a \titlerule)
   and the hook headline, linkblue RGB(0,102,204) for links, no hyphenation, itemize noitemsep with topsep=1pt, leftmargin=1.3em, partopsep=0pt,
   parsep=1pt. Four additions only: the needspace package (no heading or entry alone at the foot of a page), a zero paragraph indent (the reference
   writes \noindent by hand), the linespread value (1.02 as in the reference, which the fill step may raise in steps of 0.02) and the `muted`
   grey the role / project macros keep for dates, places and the stack line.
   Header: the name (LARGE bold), the hook headline (small bold headernavy), the location and contact line with the full URLs, and one line
   `<right to work> | <available ...>` (identity.status_line of the fact bank; printed only when the bank has it, never invented). The cover letter's
   header is the same name, headline and contact line (tailoring/company_letter.py, templates/cover_letter.tex.j2).
   Body: experience goes through role (roleNoLoc when the entry has no location), a project through project with its award or coursework label as
   badge or, when it has a public GitHub URL, the title on the left and the URL (`\hfill \url`) on the right, then the italic stack line and the bullets
   (a project with no URL is left off the CV when scoring.cv_projects_need_url is true), a skills group through skillgroup (the label on its own bold
   line, the items below it), education through roleNoLoc plus a muted small modules line, the certifications are a bulleted list with one `\item` per
   certification (name, issuer, date in italics), after one bold-led bullet per project that moved there for its award (render context
   `achievements`). Every date range uses the one separator (settings cv.date_separator, an en dash by default).
   When the bold name and the URL do not fit on one line the URL goes to the stack line, right-aligned, and when the stack and the URL do not fit
   together it gets a line of its own: TeX measures both with boxes, so the two never overlap (tailor checks the rendered PDF with
   layout.link_problems). Only a bullet's result text is wrapped in num. The vertical margin is repeated in render.CV2_MARGIN_PT (0.5in), which turns
   a PDF's last text line into the page-2 fill: change both together. Only fact-bank values are inserted (after typography.py has tidied the dashes
   and hyphens); optional fields are read with .get or default, so a missing one is skipped, never an error. }

\usepackage{fontspec}
\setmainfont{Carlito}
\usepackage[margin=0.6in, top=0.5in, bottom=0.5in]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{xcolor}
\usepackage{microtype}
\usepackage{needspace}

\hyphenpenalty=10000 \exhyphenpenalty=10000 \emergencystretch=3em

\definecolor{headernavy}{RGB}{12, 83, 166}
\definecolor{linkblue}{RGB}{0, 102, 204}
\definecolor{muted}{RGB}{96, 102, 110}

\hypersetup{colorlinks=true, linkcolor=linkblue, urlcolor=linkblue}

\titleformat{\section}
  {\color{headernavy}\normalsize\bfseries}
  {}{0em}{\MakeUppercase}[\color{headernavy}\titlerule]

\titlespacing{\section}{0pt}{8pt}{4pt}

\setlist[itemize]{noitemsep, topsep=1pt, leftmargin=1.3em, partopsep=0pt, parsep=1pt}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\linespread{\VAR{linespread|default(1.02)}}

% ---- building blocks: bold = organisation/project, italic = role/stack, grey = dates/places ----
\newcommand{\role}[4]{% org, location, dates, title
  \textbf{#1}{\color{muted}\,\textperiodcentered\,\textit{#2}}\hfill{\color{muted}#3}\\
  \textit{#4}\par}
\newcommand{\roleNoLoc}[3]{\textbf{#1}\hfill{\color{muted}#2}\\ \textit{#3}\par}
\newcommand{\project}[3]{% name, stack, right-hand tag
  \textbf{#1}\hfill#3\\ {\color{muted}\small\textit{#2}}\par}
\newcommand{\gh}[1]{\href{#1}{\small GitHub}}
\newcommand{\badge}[1]{{\color{headernavy}\small\textbf{#1}}}
\newcommand{\skillgroup}[2]{{\color{headernavy}\textbf{#1}}\\ #2\par\vspace{3pt}}
\newcommand{\gap}{\vspace{5pt}}
\newcommand{\num}[1]{\textbf{#1}}   % result numbers only


\begin{document}
\BLOCK{set res = results|default({})}
\BLOCK{set dot = '\\nobreak\\ \\,\\textperiodcentered\\, '}
\BLOCK{set bar = ' \\,\\textbar\\, '}

% ================= HEADER =================
\begin{center}
  {\LARGE\bfseries \VAR{id.name|e}} \\[3pt]
\BLOCK{set headline = hook_headline|default('') or id.headline|default('')}
\BLOCK{if headline}
  {\color{headernavy}\small\textbf{\VAR{headline|hook_tex(hook_number|default(''), 'num')}}} \\[3pt]
\BLOCK{endif}
  {\small
  \VAR{id|contact_line}}\BLOCK{if id.get('status_line')}\par\vspace{4pt}
  \noindent{} \VAR{id.status_line|map('e')|join(bar)}\BLOCK{endif}

\end{center}

% ================= PROFILE =================
\needspace{5\baselineskip}\section{Profile}
\VAR{profile|e}

% ================= SKILLS =================
\needspace{5\baselineskip}\section{Skills}
\BLOCK{for group, items in skills.items()}
\skillgroup{\VAR{group|e}}{\VAR{items|skill_row}}
\BLOCK{endfor}

% ================= EXPERIENCE =================
\needspace{5\baselineskip}\section{Work Experience}
\BLOCK{for e in experience}
\BLOCK{if not loop.first}
\gap
\BLOCK{endif}
\BLOCK{set org = e|org_parts}
\needspace{4\baselineskip}
\BLOCK{if org[1]}
\role{\VAR{org[0]|inline}}{\VAR{org[1]|inline}}{\VAR{e.dates|dates|e}}{\VAR{e|role_line|inline}}
\BLOCK{else}
\roleNoLoc{\VAR{org[0]|inline}}{\VAR{e.dates|dates|e}}{\VAR{e|role_line|inline}}
\BLOCK{endif}
\begin{itemize}
\BLOCK{for b in e.bullets}
  \item \VAR{e|bullet_at(loop.index0, res, 'num')}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endfor}

% ================= PROJECTS =================
\needspace{5\baselineskip}\section{Projects}
\BLOCK{for p in projects}
\BLOCK{if not loop.first}
\gap
\BLOCK{endif}
\BLOCK{set pp = p|project_parts}
\needspace{4\baselineskip}
\BLOCK{if not pp[1] and p.get('github')}
\setbox0=\hbox{\textbf{\VAR{pp[0]|inline}}\hspace{1em}\url{\VAR{p.github|urlesc}}}%
\BLOCK{if p.get('stack')}
\setbox2=\hbox{{\small\textit{\VAR{p.stack|e}}}\hspace{1em}{\small\url{\VAR{p.github|urlesc}}}}%
\ifdim\wd0>\linewidth
\ifdim\wd2>\linewidth
\textbf{\VAR{pp[0]|inline}}\\ {\color{muted}\small\textit{\VAR{p.stack|e}}}\\ \hspace*{\fill}{\small\url{\VAR{p.github|urlesc}}}\par
\else
\textbf{\VAR{pp[0]|inline}}\\ {\color{muted}\small\textit{\VAR{p.stack|e}}}\hfill{\small\url{\VAR{p.github|urlesc}}}\par
\fi
\else
\project{\VAR{pp[0]|inline}}{\VAR{p.stack|e}}{\url{\VAR{p.github|urlesc}}}
\fi
\BLOCK{else}
\ifdim\wd0>\linewidth
\textbf{\VAR{pp[0]|inline}}\\ \hspace*{\fill}\url{\VAR{p.github|urlesc}}\par
\else
\textbf{\VAR{pp[0]|inline}}\hfill\url{\VAR{p.github|urlesc}}\par
\fi
\BLOCK{endif}
\BLOCK{else}
\BLOCK{if p.get('stack')}
\project{\VAR{pp[0]|inline}}{\VAR{p.stack|e}}{\BLOCK{if pp[1]}\badge{\VAR{pp[1]|e}}\BLOCK{endif}}
\BLOCK{else}
\textbf{\VAR{pp[0]|inline}}\hfill \BLOCK{if pp[1]}\badge{\VAR{pp[1]|e}}\BLOCK{endif}\par
\BLOCK{endif}
\BLOCK{endif}
\begin{itemize}
\BLOCK{for b in p.bullets}
  \item \VAR{p|bullet_at(loop.index0, res, 'num')}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endfor}

% ================= EDUCATION =================
\needspace{5\baselineskip}\section{Education}
\BLOCK{for ed in education}
\BLOCK{if not loop.first}
\gap
\BLOCK{endif}
\BLOCK{set el = ed|education_lines}
\needspace{3\baselineskip}
\roleNoLoc{\VAR{ed|school_line|inline}}{\VAR{ed.dates|dates|e}}{\VAR{el[0]|inline}}
\BLOCK{if el[1]}
{\color{muted}\small \VAR{el[1]|inline}}\par
\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{if research_focus|default('')}

% ================= RESEARCH FOCUS (optional fact-bank section) =================
\needspace{5\baselineskip}\section{Research Focus}
\VAR{research_focus|e}
\BLOCK{endif}
\BLOCK{if publications|default([])}

% ================= PUBLICATIONS (optional fact-bank section) =================
\needspace{5\baselineskip}\section{Publications}
\begin{itemize}
\BLOCK{for pub in publications}
  \item \VAR{pub|publication_tex}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\BLOCK{if certifications or achievements|default([])}

% ================= CERTIFICATIONS & ACHIEVEMENTS =================
\needspace{5\baselineskip}\section{Certifications \& Achievements}
\begin{itemize}
\BLOCK{for a in achievements|default([])}
  \item \textbf{\VAR{a|achievement_head}}: \VAR{a.text|bullet(a.get('result', ''), 'num')}
\BLOCK{endfor}
\BLOCK{for c in certifications}
  \item \VAR{c|cert_tex}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\BLOCK{if languages|default([])}

% ================= LANGUAGES (optional fact-bank section) =================
\needspace{5\baselineskip}\section{Languages}
\begin{itemize}
  \item \VAR{languages|map('language_line')|map('e')|join(dot)}
\end{itemize}
\BLOCK{endif}

\end{document}
