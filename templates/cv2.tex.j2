\documentclass[a4paper,11pt]{article}
\#{ Two-page layout (the default). Preamble and macros are config/reference/cv_style_reference.tex (v2) line for line (Carlito 11pt,
   palette navy / ink / muted, ragged2e RaggedRight, no hyphenation, section headings 13pt bold navy letter-spaced uppercase with
   a 0.8pt rule, navy bullet dot, and the macros role, roleNoLoc, project, gh, badge, skillgroup, num and gap). Two additions only:
   the needspace package (no heading or entry alone at the foot of a page) and the linespread value, which the fill step may
   raise from 1.03 to 1.09 in steps of 0.02. test_cv_template.py compares both with the reference when that file is present.
   Body: experience goes through role (roleNoLoc when the entry has no location), a project through project with its award or
   coursework label as badge or its link as gh, a skills group through skillgroup (the label on its own navy bold line, the items
   below it), education through roleNoLoc plus a muted small modules line, the certifications are one bullet joined with a middle
   dot, years in italics, after one bold-led bullet per project that moved there for its award (render context `achievements`).
   A project with a github value prints that URL (url, the default url font) as its right-hand tag; the macro gh stays in the preamble
   because the preamble is the reference file line for line, but nothing calls it. When the bold name and the URL do not fit on one
   line the URL goes to the stack line, right-aligned, and when the stack and the URL do not fit together it gets a line of its own:
   TeX measures both with boxes, so the two never overlap (tailor checks the rendered PDF with layout.link_problems).
   Only a bullet's result text is wrapped in num. Type scale: name 22pt, headline 12pt (one line), headings 13pt, contact line /
   stack line / modules line 10pt (small), everything else 11pt. The vertical margin is repeated in render.CV2_MARGIN_PT (0.5in),
   which turns a PDF's last text line into the page-2 fill: change both together. Only fact-bank values are inserted (after
   typography.py has tidied the dashes and hyphens); optional fields are read with .get or default, so a missing one is skipped,
   never an error. }

\usepackage{fontspec}
\setmainfont{Carlito}
\usepackage[margin=0.6in, top=0.5in, bottom=0.5in]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{xcolor}
\usepackage[colorlinks=true]{hyperref}
\usepackage{microtype}
\usepackage{ragged2e}
\usepackage{needspace}

% ---- palette: one accent, one ink, one muted grey ----
\definecolor{navy}{RGB}{12, 83, 166}
\definecolor{ink}{RGB}{33, 37, 41}
\definecolor{muted}{RGB}{96, 102, 110}
\hypersetup{urlcolor=navy, linkcolor=navy}
\color{ink}

% ---- ragged right, no hyphenation: even word spacing, no split words ----
\hyphenpenalty=10000 \exhyphenpenalty=10000 \emergencystretch=3em
\setlength{\parindent}{0pt}
\pagestyle{empty}
\linespread{\VAR{linespread|default(1.03)}}
\AtBeginDocument{\RaggedRight}

% ---- type scale (ratio ~1.2): body 11 -> headline 12 -> section 13 -> name 22 ----
\titleformat{\section}
  {\color{navy}\fontsize{13}{15}\selectfont\bfseries\addfontfeature{LetterSpace=6}}
  {}{0em}{\MakeUppercase}[{\color{navy}\vspace{1pt}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{9pt}{5pt}

\setlist[itemize]{label={\color{navy}\small\textbullet}, leftmargin=1.1em, labelsep=0.45em,
  itemsep=1.5pt, parsep=0pt, topsep=2pt, partopsep=0pt}

% ---- building blocks: bold = organisation/project, italic = role/stack, grey = dates/places ----
\newcommand{\role}[4]{% org, location, dates, title
  \textbf{#1}{\color{muted}\,\textperiodcentered\,\textit{#2}}\hfill{\color{muted}#3}\\
  \textit{#4}\par}
\newcommand{\roleNoLoc}[3]{\textbf{#1}\hfill{\color{muted}#2}\\ \textit{#3}\par}
\newcommand{\project}[3]{% name, stack, right-hand tag
  \textbf{#1}\hfill#3\\ {\color{muted}\small\textit{#2}}\par}
\newcommand{\gh}[1]{\href{#1}{\small GitHub}}
\newcommand{\badge}[1]{{\color{navy}\small\textbf{#1}}}
\newcommand{\skillgroup}[2]{{\color{navy}\textbf{#1}}\\ #2\par\vspace{3pt}}
\newcommand{\gap}{\vspace{5pt}}
\newcommand{\num}[1]{\textbf{#1}}   % result numbers only


\begin{document}
\BLOCK{set res = results|default({})}
\BLOCK{set dot = '\\nobreak\\ \\,\\textperiodcentered\\, '}

% ================= HEADER =================
\begin{center}
  {\fontsize{22}{26}\selectfont\bfseries\color{navy} \VAR{id.name|e}}\\[4pt]
\BLOCK{set headline = hook_headline|default('') or id.headline|default('')}
\BLOCK{if headline}
  {\fontsize{12}{14}\selectfont\color{navy} \VAR{headline|hook_tex(hook_number|default(''), 'num')}}\\[4pt]
\BLOCK{endif}
  {\small
  \VAR{id.location|e}\VAR{dot}\href{mailto:\VAR{id.email}}{\VAR{id.email|e}}\BLOCK{if id.get('phone')}\VAR{dot}\href{tel:\VAR{id.phone|replace(' ', '')}}{\VAR{id.phone|e}}\BLOCK{endif}\BLOCK{for k in ['linkedin', 'github', 'portfolio'] if id.get('links') and id.links.get(k)}\VAR{dot}\href{\VAR{id.links[k]|urlesc}}{\VAR{'Portfolio' if k == 'portfolio' else id.links[k]|urlshow|e}}\BLOCK{endfor}}\BLOCK{if id.get('status_line')}\\[3pt]
  {\small\itshape\color{muted} \VAR{id.status_line|map('e')|join(dot)}}
\BLOCK{endif}

\end{center}

% ================= PROFILE =================
\needspace{5\baselineskip}\section{Profile}
\VAR{profile|e}

% ================= SKILLS =================
\needspace{5\baselineskip}\section{Skills}
\BLOCK{for group, items in skills.items()}
\skillgroup{\VAR{group|e}}{\VAR{items|skill_row}}
\BLOCK{endfor}

% ================= EXPERIENCE =================
\needspace{5\baselineskip}\section{Work Experience}
\BLOCK{for e in experience}
\BLOCK{if not loop.first}
\gap
\BLOCK{endif}
\BLOCK{set org = e|org_parts}
\needspace{4\baselineskip}
\BLOCK{if org[1]}
\role{\VAR{org[0]|inline}}{\VAR{org[1]|inline}}{\VAR{e.dates|dates|e}}{\VAR{e|role_line|inline}}
\BLOCK{else}
\roleNoLoc{\VAR{org[0]|inline}}{\VAR{e.dates|dates|e}}{\VAR{e|role_line|inline}}
\BLOCK{endif}
\begin{itemize}
\BLOCK{for b in e.bullets}
  \item \VAR{e|bullet_at(loop.index0, res, 'num')}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endfor}

% ================= PROJECTS =================
\needspace{5\baselineskip}\section{Projects}
\BLOCK{for p in projects}
\BLOCK{if not loop.first}
\gap
\BLOCK{endif}
\BLOCK{set pp = p|project_parts}
\needspace{4\baselineskip}
\BLOCK{if not pp[1] and p.get('github')}
\setbox0=\hbox{\textbf{\VAR{pp[0]|inline}}\hspace{1em}\url{\VAR{p.github|urlesc}}}%
\BLOCK{if p.get('stack')}
\setbox2=\hbox{{\small\textit{\VAR{p.stack|e}}}\hspace{1em}{\small\url{\VAR{p.github|urlesc}}}}%
\ifdim\wd0>\linewidth
\ifdim\wd2>\linewidth
\textbf{\VAR{pp[0]|inline}}\\ {\color{muted}\small\textit{\VAR{p.stack|e}}}\\ \hfill{\small\url{\VAR{p.github|urlesc}}}\par
\else
\textbf{\VAR{pp[0]|inline}}\\ {\color{muted}\small\textit{\VAR{p.stack|e}}}\hfill{\small\url{\VAR{p.github|urlesc}}}\par
\fi
\else
\project{\VAR{pp[0]|inline}}{\VAR{p.stack|e}}{\url{\VAR{p.github|urlesc}}}
\fi
\BLOCK{else}
\ifdim\wd0>\linewidth
\textbf{\VAR{pp[0]|inline}}\\ \hfill\url{\VAR{p.github|urlesc}}\par
\else
\textbf{\VAR{pp[0]|inline}}\hfill\url{\VAR{p.github|urlesc}}\par
\fi
\BLOCK{endif}
\BLOCK{else}
\BLOCK{if p.get('stack')}
\project{\VAR{pp[0]|inline}}{\VAR{p.stack|e}}{\BLOCK{if pp[1]}\badge{\VAR{pp[1]|e}}\BLOCK{endif}}
\BLOCK{else}
\textbf{\VAR{pp[0]|inline}}\hfill \BLOCK{if pp[1]}\badge{\VAR{pp[1]|e}}\BLOCK{endif}\par
\BLOCK{endif}
\BLOCK{endif}
\begin{itemize}
\BLOCK{for b in p.bullets}
  \item \VAR{p|bullet_at(loop.index0, res, 'num')}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endfor}

% ================= EDUCATION =================
\needspace{5\baselineskip}\section{Education}
\BLOCK{for ed in education}
\BLOCK{if not loop.first}
\gap
\BLOCK{endif}
\BLOCK{set el = ed|education_lines}
\needspace{3\baselineskip}
\roleNoLoc{\VAR{ed|school_line|inline}}{\VAR{ed.dates|dates|e}}{\VAR{el[0]|inline}}
\BLOCK{if el[1]}
{\color{muted}\small \VAR{el[1]|inline}}\par
\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{if research_focus|default('')}

% ================= RESEARCH FOCUS (optional fact-bank section) =================
\needspace{5\baselineskip}\section{Research Focus}
\VAR{research_focus|e}
\BLOCK{endif}
\BLOCK{if publications|default([])}

% ================= PUBLICATIONS (optional fact-bank section) =================
\needspace{5\baselineskip}\section{Publications}
\begin{itemize}
\BLOCK{for pub in publications}
  \item \VAR{pub|publication_tex}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\BLOCK{if certifications or achievements|default([])}

% ================= CERTIFICATIONS & ACHIEVEMENTS =================
\needspace{5\baselineskip}\section{Certifications \& Achievements}
\begin{itemize}
\BLOCK{for a in achievements|default([])}
  \item \textbf{\VAR{a|achievement_head}}: \VAR{a.text|bullet(a.get('result', ''), 'num')}
\BLOCK{endfor}
\BLOCK{if certifications}
  \item \VAR{certifications|map('cert_tex')|join(dot)}
\BLOCK{endif}
\end{itemize}
\BLOCK{endif}
\BLOCK{if languages|default([])}

% ================= LANGUAGES (optional fact-bank section) =================
\needspace{5\baselineskip}\section{Languages}
\begin{itemize}
  \item \VAR{languages|map('language_line')|map('e')|join(dot)}
\end{itemize}
\BLOCK{endif}

\end{document}
