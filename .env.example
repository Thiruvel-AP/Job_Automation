# copy to .env and fill in; never commit
GROQ_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
HUNTER_API_KEY=
# v3.5 / v3.5a: optional. A long-lived Claude Code login for unattended `claude -p` judge calls (made with `claude setup-token`).
# Without it the judge relies on `claude auth status` (your normal login). Never printed or logged (doctor redacts it).
CLAUDE_CODE_OAUTH_TOKEN=
# v3.9.3: the target region and company size, asked once at a terminal and saved here (change with `careerops prefs set region|size VALUE`).
# CAREEROPS_REGION: uk, ie, eu, us, any, a two-letter country code, or a list such as uk,ie. Scheduled runs with nothing saved use uk.
# CAREEROPS_COMPANY_SIZE: sme | large | both_sme_first | both_large_first | both. Scheduled runs with nothing saved use both.
# CAREEROPS_REGION=uk
# CAREEROPS_COMPANY_SIZE=both

# Gmail OAuth client (GCP → Credentials → OAuth client ID → Desktop app); preferred over data/secrets/gmail_client.json
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
