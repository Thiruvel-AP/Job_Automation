    {
      "id": "az1",
      "entry": "AstraZeneca",
      "text": "Built a tool-calling LLM agent (LangChain, AWS Bedrock, Claude Haiku 4.5) for a multi-omics cancer research platform, with three tools for gene alias resolution, scoring-methodology explanation and dataset provenance."
    },
    {
      "id": "az6",
      "entry": "AstraZeneca",
      "text": "Integrated the agent into a React front end with real-time gene alias enrichment."
    },
    {
      "id": "dc7",
      "entry": "180 Degrees Consulting Bristol",
      "text": "Proposed the request flow: a user's text goes through the API and a customised prompt to the MCP server, where one LLM instance writes GraphQL queries against the client's Convex database and a second instance runs the statistical analysis before the result returns to the user."
    },
    {
      "id": "dc8",
      "entry": "180 Degrees Consulting Bristol",
      "text": "Carried it into production with the client's engineering team: contributed to their production TypeScript/Node.js MCP server (OpenAI-based query generation, Convex), now in live use, and reviewed pull requests in the client's production repository alongside their CTO."
    },
    {
      "id": "fl1",
      "entry": "Freelance",
      "text": "Built scikit-learn pipelines and LSTM/BiRNN/CNN models in TensorFlow/Keras, deployed as FastAPI services in Docker."
    },
    {
      "id": "fl4",
      "entry": "Freelance",
      "text": "Built a production RAG and agentic retrieval system (Claude API, LangChain, LangGraph, ChromaDB) served through a FastAPI REST API in Docker on GCP Cloud Run."
    },
    {
      "id": "fl5",
      "entry": "Freelance",
      "text": "Designed reproducible scikit-learn pipelines with feature engineering (temporal features, interaction terms, target encoding), model selection, cross-validation and hyperparameter tuning across classification and regression tasks."
    },
    {
      "id": "av5",
      "entry": "Avasoft",
      "text": "Implemented offline-first data persistence (Isar) with background synchronisation in the Flutter FinTech app, keeping financial records available in low-connectivity conditions."
    },
    {
      "id": "av8",
      "entry": "Avasoft",
      "text": "Shipped features in a production fintech (financial-services) application as part of a team: integrated Twelve Data (real-time market feeds) and Plaid (bank linking, transaction imports) via REST APIs, with SSL pinning and AWS Cognito SSO."
    },
    {
      "id": "av10",
      "entry": "Avasoft",
      "text": "As a trainee, modelled user-profile, transaction-history and event-booking data in Core Data schemas with CRUD and session-state management, and automated a manual data-collection process with a JavaScript web-scraping pipeline that surfaced market-trend signals used for pricing decisions."
    },
    {
      "id": "p_af1",
      "entry": "AgenticFriend \u2014 real-time voice assistant",
      "text": "Full-duplex WebSocket voice agent with a rolling VAD state machine for streaming speech-to-text (faster-whisper) and barge-in."
    }
  ],
