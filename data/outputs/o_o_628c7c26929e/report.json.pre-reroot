  "needs_result": [
    {
      "id": "az1",
      "entry": "AstraZeneca \u00b7 GeneTraceAI, University of Bristol",
      "text": "Built a tool-calling LLM agent (LangChain, AWS Bedrock, Claude Haiku 4.5) for a multi-omics cancer research platform, with three tools for gene alias resolution, scoring-methodology explanation and dataset provenance."
    },
    {
      "id": "az2",
      "entry": "AstraZeneca \u00b7 GeneTraceAI, University of Bristol",
      "text": "Designed a deterministic hallucination-guard architecture and fail-safe data resolution via live Ensembl/HGNC APIs with a local 19,213-gene parquet fallback and circuit breakers."
    },
    {
      "id": "az3",
      "entry": "AstraZeneca \u00b7 GeneTraceAI, University of Bristol",
      "text": "Deployed the agent as a Docker container on AWS Lambda (Lambda Web Adapter) with ECR image pipelines, IAM execution roles and least-privilege policies."
    },
    {
      "id": "az4",
      "entry": "AstraZeneca \u00b7 GeneTraceAI, University of Bristol",
      "text": "Wrote a three-tier test framework (tool-level, API/integration, live agent) of ~65 tests across 8 files, validated across the LLM provider migration from Groq to AWS Bedrock after a rate-limit evaluation."
    },
    {
      "id": "az5",
      "entry": "AstraZeneca \u00b7 GeneTraceAI, University of Bristol",
      "text": "Surveyed and explored 14 heterogeneous source datasets (gene expression, gene properties, nomenclature), owning the identity-spine datasets and setting metadata boundaries for downstream modelling."
    },
    {
      "id": "az6",
      "entry": "AstraZeneca \u00b7 GeneTraceAI, University of Bristol",
      "text": "Integrated the agent into a React front end with real-time gene alias enrichment."
    },
    {
      "id": "az7",
      "entry": "AstraZeneca \u00b7 GeneTraceAI, University of Bristol",
      "text": "Managed AWS account governance for the project, including root-user isolation, IAM user and group management and least-privilege policies."
    },
    {
      "id": "dc1",
      "entry": "180 Degrees Consulting Bristol",
      "text": "Proposed and prototyped an MCP-based agentic tool in Python (FastMCP, Ollama gpt-oss:20b, PostgreSQL, GitHub Actions CI) for a Madrid-based product start-up client, presented in a live stakeholder demo."
    },
    {
      "id": "dc2",
      "entry": "180 Degrees Consulting Bristol",
      "text": "Contributed the MCP implementation to the client's production repository (TypeScript/Node.js MCP server, OpenAI query generation, Convex database), now in live day-to-day use; engagement received a 5-star commendation from senior leadership."
    },
    {
      "id": "fl1",
      "entry": "Self-employed, Chennai",
      "text": "Built scikit-learn pipelines and LSTM/BiRNN/CNN models in TensorFlow/Keras, deployed as FastAPI services in Docker."
    },
    {
      "id": "fl2",
      "entry": "Self-employed, Chennai",
      "text": "Built NLP and agentic RAG workflows with Hugging Face Transformers, Ollama, LangChain and LangGraph."
    },
    {
      "id": "fl3",
      "entry": "Self-employed, Chennai",
      "text": "Contributed to a team LoRA fine-tune of an instruction-tuned Llama model for a maths-focused task."
    },
    {
      "id": "fl4",
      "entry": "Self-employed, Chennai",
      "text": "Built a production RAG and agentic retrieval system (Claude API, LangChain, LangGraph, ChromaDB) served through a FastAPI REST API in Docker on GCP Cloud Run."
    },
    {
      "id": "av1",
      "entry": "Avasoft",
      "text": "Integrated Twelve Data (real-time market feeds) and Plaid (bank-account linkage, transaction imports) APIs into a Flutter FinTech mobile app."
    },
    {
      "id": "av5",
      "entry": "Avasoft",
      "text": "Implemented offline-first data persistence (Isar) with background synchronisation in the Flutter FinTech app, keeping financial records available in low-connectivity conditions."
    },
    {
      "id": "av2",
      "entry": "Avasoft",
      "text": "Delivered 10 reusable SwiftUI/UIKit component templates that accelerated team velocity across concurrent releases."
    },
    {
      "id": "av3",
      "entry": "Avasoft",
      "text": "Designed Core Data schemas for user profiles, transaction histories and event bookings with CRUD and session-state management."
    },
    {
      "id": "av4",
      "entry": "Avasoft",
      "text": "Built a JavaScript web-scraping pipeline that automated a manual collection process and surfaced market-trend signals used for pricing decisions."
    },
    {
      "id": "p_ch1",
      "entry": "Banking Customer Churn",
      "text": "XGBoost churn classifier in R (tidymodels) with two-stage Bayesian hyperparameter search, SMOTE inside the recipe and MCC evaluation."
    },
    {
      "id": "p_ll1",
      "entry": "Lloyd's Banking Group Datathon \u2014 3rd place",
      "text": "Anomaly detection on 200:1 class-imbalanced data with Isolation Forest and ensemble classifiers, tracked in MLflow."
    },
    {
      "id": "p_ms1",
      "entry": "mcp_searchagent",
      "text": "MCP server and stdio client combining web search with a GraphQL/PostgreSQL data layer, run against a local open-weight model (gpt-oss:20b) with CI across Python 3.9\u20133.11."
    }
