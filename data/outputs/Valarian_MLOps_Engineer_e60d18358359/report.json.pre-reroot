  "context": {
    "id": {
      "name": "Thiruvel Andagurunathan Pandian",
      "headline": "Machine Learning Engineer",
      "email": "apthiruvel@gmail.com",
      "phone": "+44 7741 016954",
      "location": "Bristol, UK",
      "links": {
        "linkedin": "https://www.linkedin.com/in/thiruvel-a-p/",
        "github": "https://github.com/Thiruvel-AP",
        "portfolio": "https://thiruvel-ap.github.io/PersonalPortfolio/"
      },
      "status_line": [
        "Right to Work in UK",
        "Available to join Immediately"
      ]
    },
    "profile": "AI engineer who builds the harness around the model: at AstraZeneca I built a tool-calling LLM agent that recovers when its tools fail, and diagnosed its failures with a three-tier, ~65-test evaluation harness. Over a year of hands-on experience building and deploying machine learning and LLM systems. Owns data workflows end-to-end in Python and SQL, from merging structured, API and web-scraped data through feature creation, tuning, validation and deployment (Docker, GitHub Actions CI/CD, MLflow, AWS Lambda).",
    "skills": {
      "Agentic AI & LLM Applications": "Tool calling and failure recovery (LangChain, LangGraph, Google ADK, ReAct agent loops; circuit breakers, fallbacks, deterministic guardrails), multi-provider LLMs (OpenAI, Anthropic Claude on AWS Bedrock, Google Gemini via LiteLLM, open-weight models via Ollama), LLM evaluation (three-tier tests, hallucination-rate analysis), agent memory (persistent storage and retrieval across sessions), RAG pipelines (retrieval, generation, embeddings and the ChromaDB vector database), MCP servers (FastMCP, TypeScript SDK), prompt engineering, AI-assisted development (Claude Code as primary tool, Cursor, OpenAI Codex)",
      "Software Engineering & Integrations": "TypeScript/Node.js, React, Python, JavaScript, FastAPI, Pydantic, RESTful APIs and third-party API integrations, GraphQL, PostgreSQL, SQL, MongoDB and DynamoDB (NoSQL), graph data (networkx), pytest, Git (pull requests, code review), debugging and root-cause analysis",
      "Cloud & Deployment": "AWS (Bedrock, Lambda, ECR, S3, SQS, EC2, IAM, Cognito), GCP (Cloud Run), Docker, Kubernetes (AWS EKS), GitHub Actions CI/CD, serverless deployment"
    },
    "experience": [
      {
        "id": "az",
        "display_org": "AstraZeneca, United Kingdom",
        "title": "Data Scientist",
        "org": "AstraZeneca",
        "location": "Bristol, UK (Remote)",
        "employment_type": "indirect contract",
        "dates": "May 2026 \u2013 Sep 2026",
        "situation": "Needed an LLM a research team could trust before it shipped",
        "bullets": [
          "Needed an agent that researchers could trust on a cancer research platform, including when its tools fail: built a tool-calling agent (LangChain, Claude Haiku 4.5 on AWS Bedrock) for three use cases (gene alias resolution, prompt-engineered explanations of a fixed scoring pipeline, validated dataset descriptions), with deterministic Ensembl and HGNC calls, deterministic hallucination guards, and circuit breakers with a 19,213-gene parquet fallback for when the external APIs are unavailable.",
          "Integrated the agent into a React front end with real-time gene alias enrichment.",
          "Diagnosed where it struggled with a three-tier, ~65-test evaluation harness (tool-level \u2192 API \u2192 live) and hallucination-rate analysis, debugging failures layer by layer, and used the same harness to validate the Groq to Bedrock migration after a rate-limit evaluation.",
          "Built the Python data pipeline: reconciled 14 heterogeneous source datasets through identifier crosswalks so the agent used trusted data, then deployed it as a Docker image on AWS Lambda (ECR, least-privilege IAM) and documented the architecture and evaluation."
        ],
        "bullet_ids": [
          "az10",
          "az6",
          "az11",
          "az12"
        ]
      },
      {
        "id": "dc180",
        "display_org": "180 Degrees Consulting",
        "title": "Data Consultant (AI Engineering & AI System)",
        "org": "180 Degrees Consulting Bristol",
        "location": "Bristol, UK (Remote)",
        "employment_type": "internship",
        "situation": "Faced a loosely defined problem from a Madrid based startup client",
        "dates": "Sep 2025 \u2013 Dec 2025",
